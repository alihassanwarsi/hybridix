# Embedding and chunking
HYBRIDIX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HYBRIDIX_CHUNK_SIZE=2000
HYBRIDIX_CHUNK_OVERLAP=200

# Versioned index storage
HYBRIDIX_INDEX_ROOT=data/indexes

# ChromaDB
HYBRIDIX_CHROMA_COLLECTION_NAME=hybridix

# Retrieval
HYBRIDIX_DENSE_TOP_K=10
HYBRIDIX_SPARSE_TOP_K=10
HYBRIDIX_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Answer generation
HYBRIDIX_GROQ_API_KEY=replace_with_your_groq_key
HYBRIDIX_GENERATION_MODEL=openai/gpt-oss-120b

# RAGAS evaluation
HYBRIDIX_OPENAI_API_KEY=replace_with_your_openai_key
HYBRIDIX_EVALUATION_MODEL=gpt-4.1-mini